ki-cn:credit:end]]\n[[include :backrooms-wiki-cn:theme:super-liminal\n|wide=a\n]]\n[[include :snippets:html5player\n|type=audio\n|url=http://brsandbox-mini.wikidot.com/local--files/secret:entity-as-80/%E8%90%A5%E9%94%80%E5%8F%B7%E7%9A%84%E5%B0%8F%E6%9B%B2\n|autoplay=true\n]]\n[[include :backrooms-wiki-cn:component:title\n|1=\u5df4\u514b\u8089\u4e1d\u5199\u4f5c\u6307\u5357\n|2=\u5341 \u5206 \u6709 \u7528 \n|m=a\n|m1=\u5df4\u514b\u8089\u4e1d\u5199\u4f5c\u6307\u5357\n|m2=\u5341 \u5206 \u6709 \u7528\n]]\n[[include :backrooms-wiki-cn:component:sd-class\n|class=0\n|color=\n|image=\n|one=\u5b9e\u7528\n|two=\u65b9\u4fbf\n|three=\u6709\u6548\n]]\n\n\n[[module css]]\n@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC&display=swap');\n[[/module]]\n\n\n[[div style=\"font-family: 'Noto Serif SC', serif;\"]]\n\n\n\n\u5982\u4f55\u64b0\u5199\u4e00\u7bc7\u5c42\u7ea7\uff0c\u5c0f\u7f16\u601d\u8003\u4e86\u5f88\u4e45\u624d\u60f3\u51fa\u8fd9\u4e2a\u95ee\u9898\u7684\u7b54\u6848\uff0c\u4e0b\u9762\u8ba9\u5c0f\u7f16\u8ddf\u5927\u5bb6\u770b\u770b\u5427\u3002\n\n+ **{{\u63cf\u8ff0}}**\n\u63cf\u8ff0\u4e3b\u8981\u662f\u63cf\u8ff0\u8fd9\u4e2a\u5c42\u7ea7\u6587\u957f\u4ec0\u4e48\u6837\u5b50\uff0c\u9700\u8981\u6ce8\u610f\u7684\u662f\uff0c\u63cf\u8ff0\u7684\u610f\u601d\u901a\u5e38\u6307\u8be6\u7ec6\u7684\u53d9\u8ff0\u4e00\u6837\u4e1c\u897f\uff0c\u800c\u53d9\u8ff0\u7684\u610f\u601d\u5219\u662f\u5c06\u4e8b\u60c5\u7684\u524d\u56e0\u540e\u679c\u7ed9\u5199\u4e0b\u6765\uff0c\u6240\u4ee5\u73b0\u5728\u5199\u5c42\u7ea7\u5e94\u8be5\u628a\u5c42\u7ea7\u7684\u524d\u56e0\u540e\u679c\u5199\u4e0b\u6765\u5462\uff0c\u6587\u7ae0\u53ef\u4ee5\u53d9\u8ff0\u5c42\u7ea7\u7684\u5404\u79cd\u5f71\u54cd\u4e4b\u7c7b\u7684\uff0c\u56e0\u6b64\u63cf\u8ff0\u53ef\u4ee5\u7528\u6765\u5199\u5c42\u7ea7\uff0c\u662f\u5c42\u7ea7\u7684\u4e3b\u4f53\u90e8\u5206\uff0c\u5927\u5bb6\u5e73\u65f6\u5728\u63cf\u8ff0\u4e00\u7bc7\u5c42\u7ea7\u7684\u65f6\u5019\u4e00\u5b9a\u8981\u6ce8\u610f\u597d\u5c42\u7ea7\u7684\u5404\u79cd\u63cf\u8ff0\u65b9\u6cd5\uff0c\u9700\u8981\u6ce8\u610f\u7684\u662f\uff0c\u5c42\u7ea7\u7684\u63cf\u8ff0\u901a\u5e38\u5360\u7528\u5f88\u591a\u7684\u5b57\uff0c\u6240\u4ee5\u5927\u5bb6\u5e73\u65f6\u8981\u5c3d\u91cf\u5199\u597d\u63cf\u8ff0\u90e8\u5206\u3002\n+ **{{\u57fa\u5730\u3001\u524d\u54e8\u548c\u793e\u533a}}**\n\u57fa\u5730\u524d\u54e8\u4e0e\u793e\u533a\u662f\u540e\u5ba4\u4e2d\u5c42\u7ea7\u7b2c\u4e8c\u91cd\u8981\u7684\u90e8\u5206\uff0c\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u57fa\u5730\u524d\u54e8\u4e0e\u793e\u533a\u5f88\u6709\u53ef\u80fd\u5728\u4e0d\u540c\u6761\u4ef6\u4e0b\u6307\u4e0d\u540c\u7684\u4e1c\u897f\uff0c\u4f8b\u5982\u57fa\u5730\u53ef\u4ee5\u5728\u519b\u4e8b\uff0c\u6559\u80b2\uff0c\u533b\u7597\uff0c\u4f01\u4e1a\u7684\u5404\u65b9\u9762\u62e5\u6709\u4e0d\u540c\u7684\u610f\u601d\uff0c\u800c\u524d\u54e8\u66f4\u7528\u4e8e\u5728\u519b\u4e8b\u65b9\u9762\uff0c\u793e\u533a\u5728\u7f51\u7edc\u4e0a\u662f\u5f88\u65b9\u4fbf\u5c31\u80fd\u67e5\u8be2\u5230\u7684\uff0c\u5927\u5bb6\u5728\u5e73\u65f6\u5199\u5c42\u7ea7\u65f6\u901a\u5e38\u7528\u54ea\u4e2a\u793e\u533a\u8fdb\u884c\u4ea4\u6d41\u6c9f\u901a\u4ee5\u627e\u5230\u529e\u6cd5\u53bb\u5199\u5c42\u7ea7\u5462?\u6b22\u8fce\u5927\u5bb6\u5728\u8bc4\u8bba\u533a\u7559\u8a00\uff0c\u5e2e\u52a9\u66f4\u591a\u4eba\u53bb\u4e86\u89e3\u5982\u4f55\u5199\u597d\u4e00\u7bc7\u5c42\u7ea7\uff0c\u901a\u5e38\u6765\u8bf4\u8fd9\u4e9b\u7684\u5efa\u7acb\u8005\u6709M.E.G\u548cB.N.T.G\u7b49\u56e2\u4f53\uff0c\u800c\u5927\u5bb6\u77e5\u9053\u5417?\u5c0f\u7f16\u5728\u8fd9\u91cc\u7ed9\u5927\u5bb6\u79d1\u666e\u4e2a\u5c0f\u5e38\u8bc6\uff0cM.E.G\u548cB.N.T.G\u7684\u82f1\u6587\u5206\u522b\u662fMajor Explorer Group\u548c5the Backrooms Nonaligned Trade Group\uff0c\u4e2d\u6587\u610f\u601d\u7adf\u7136\u662f\u63a2\u9669\u8005\u603b\u7763\u548c\u4e0d\u7ed3\u76df\u8d38\u6613\u96c6\u56e2\u7684\u610f\u601d\uff0c\u600e\u4e48\u6837\uff0c\u662f\u4e0d\u662f\u611f\u89c9\u82f1\u8bed\u5728\u5199\u4e00\u7bc7\u5c42\u7ea7\u6587\u65f6\u7528\u5904\u5f88\u5927\u5462?\u5e73\u65f6\u5c0f\u4f19\u4f34\u4eec\u53ef\u4ee5\u591a\u7ec3\u4e60\u82f1\u8bed\u6765\u63d0\u9ad8\u81ea\u5df1\u5199\u5c42\u7ea7\u7684\u6c34\u5e73\u54e6\u3002\n\n+ **{{\u5165\u53e3\u548c\u51fa\u53e3}}**\n\u5165\u53e3\u548c\u51fa\u53e3\u6307\u7684\u662f\u6587\u7ae0\u4e2d\u8fdb\u5165\u4e00\u4e2a\u5c42\u7ea7\u6240\u7ecf\u8fc7\u7684\u5730\u65b9\u5462\uff0c\u800c\u901a\u8fc7\u89c4\u5f8b\u6765\u770b\uff0c\u51fa\u53e3\u7684\u610f\u601d\u662f\u6587\u7ae0\u4e2d\u79bb\u5f00\u8fd9\u4e2a\u5c42\u7ea7\u8981\u7ecf\u8fc7\u7684\u5730\u65b9\u54e6\uff0c\u600e\u4e48\u6837\uff0c\u903b\u8f91\u5728\u5199\u5c42\u7ea7\u6587\u91cc\u662f\u4e0d\u662f\u5f88\u6709\u7528\u5904?\n+++ {{\u5165\u53e3}}\n\u60f3\u8981\u5199\u5165\u53e3\uff0c\u4e00\u5b9a\u8981\u8054\u7cfb\u597d\u8fd9\u4e2a\u5c42\u7ea7\u8fdb\u5165\u7684\u65b9\u6cd5\u54e6\uff0c\u800c\u4e0d\u662f\u5c06\u5176\u9519\u60f3\u6210\u56fd\u5bb6\u8d38\u6613\u5f80\u6765\u7684\u53e3\u5cb8\u54e6\uff0c\u4f8b\u5982\u5927\u90e8\u5206\u6d77\u6e2f\u5176\u5b9e\u5c31\u662f\u56fd\u5bb6\u8d38\u6613\u5f80\u6765\u7684\u53e3\u5cb8\uff0c\u56e0\u6b64\u5bf9\u8fd9\u4e9b\u56fd\u5bb6\u6765\u8bf4\u6240\u8c13\u7684\u201c\u5165\u53e3\u201d\u662f\u5f88\u91cd\u8981\u7684\uff0c\u600e\u4e48\u6837\uff0c\u542c\u5b8c\u5c0f\u7f16\u7684\u89e3\u91ca\uff0c\u4f60\u662f\u5426\u5bf9\u5165\u53e3\u4e00\u8bcd\u7528\u4e86\u66f4\u8be6\u7ec6\u7684\u7406\u89e3\u548c\u89c2\u70b9\u5462\uff1f\u6b22\u8fce\u6765\u8bc4\u8bba\u533a\u8865\u5145\u4f60\u7684\u89c2\u70b9\n\n+++ {{\u51fa\u53e3}}\n\u8ddf\u5165\u53e3\u4e00\u6837\uff0c\u51fa\u53e3\u7684\u610f\u601d\u6307\u7269\u7406\u7a7a\u95f4\u4e2d\u7684\u901a\u9053\uff0c\u4f46\u5176\u5b9e\u51fa\u53e3\u6709\u65f6\u53ef\u4ee5\u662f\u56fd\u5bb6\u8d38\u6613\u5f80\u6765\u7684\u53e3\u5cb8\u54e6\uff0c\u5c0f\u4f19\u4f34\u4eec\uff0c\u901a\u8fc7\u8fd9\u4e9b\u89e3\u91ca\uff0c\u4f60\u662f\u5426\u610f\u8bc6\u5230\u597d\u597d\u4e86\u89e3\u5404\u79cd\u540d\u8bcd\u5bf9\u4ed6\u4eec\u8fdb\u884c\u8be6\u7ec6\u89e3\u91ca\u7684\u91cd\u8981\u6027\u4e86\u5462\uff1f\u5982\u679c\u8fd9\u7bc7\u5982\u4f55\u64b0\u5199\u4e00\u7bc7\u5c42\u7ea7\u7684\u6307\u5bfc\u5e2e\u52a9\u5230\u4e86\u4f60\uff0c\u8bf7\u4e3a\u5c0f\u7f16\u6309\u4e00\u4e2a\u5927\u5927\u7684\u8d5e\uff01\n------\n[[>]]\n[[collapsible show=\"\u4f5c\u8005\u4fe1\u606f\u5728Wikiodt\u53ef\u4ee5\u7528*user\u8fd9\u4e2a\u4ee3\u7801\u5462\uff0c\u8bb0\u5f97\u4e24\u8fb9\u8981\u7528[]X2\u54e6\" hide=\"\u6548\u679c\"]]\n**\u4f5c\u8005\uff1a**[[*user Airyn]]\n[[/collapsible]]\n[[/>]]\n\n[[div class=\"footer-wikiwalk-nav\"]]\n[[=]]\n<< [[[\u5982\u4f55\u5b66\u4f1a\u7528\u952e\u76d8\u6253\u5b57]]] | \u5982\u4f55\u64b0\u5199\u4e00\u7bc7\u5c42\u7ea7| [[[\u5982\u4f55\u53bb\u4f7f\u7528\u4fdd\u5b58\u6309\u94ae]]] >>\n[[/=]]\n[[/div]]\n[[/div]]", "discuss_link": "https://asbackroom.wikidot.com/forum/t-18321188", "post_id": 9026027, "timestamp": 1786935653.958, "status": "frozen"}, {"link": "https://asbackroom.wikidot.com/deleted:level-as-238", "title": "Level As 238", "score": -4, "release_score": -2, "time": -189.0, "context": "", "discuss_link": "https://asbackroom.wikidot.com/forum/t-18288262", "post_id": 8933276, "timestamp": 1786455044.44, "status": "frozen"}], "deleted_pages": [{"link": "https://asbackroom.wikidot.com/deleted:level-as-999-hmid1296", "title": "Level AS-999 - \u201c\u7ec8\u70b9\u7ad9\u201d", "score": -4, "time": 72, "context": "[[include :backrooms-wiki-cn:theme:basalt darkmode=a|centertitle=a]]\n[[=]]\n> \u201c\u5c0a\u656c\u7684\u4e58\u5ba2\uff0c\u6211\u4eec\u5373\u5c06\u62b5\u8fbe\u672c\u6b21\u5217\u8f66\u7684\u7ec8\u70b9\u7ad9\u2014\u2014**Level AS-999**\u3002\u8bf7\u5168\u4f53\u4e58\u5ba2\u51c6\u5907\u4ece\u5de6\u4fa7\u8f66\u95e8\u4e0b\u8f66\uff0c\u5c0f\u5fc3\u7ad9\u53f0\u7a7a\u9699\uff0c\u6ce8\u610f\u811a\u4e0b\u5b89\u5168\u3002\u201d\n@@@@\n@@@@\n@@@@\n@@@@\n@@@@\n@@@@\n\u6240\u6709\u4eba\u90fd\u7ad9\u4e86\u8d77\u6765\uff0c\u7b49\u5f85\u4e0b\u8f66\uff0c\u4f60\u4e5f\u5305\u62ec\u5728\u5185\u3002\n@@@@\n@@@@\n@@@@\n@@@@\n@@@@\n@@@@\n\u4f60\u601d\u7eea\u4e07\u5343\uff0c\u6fc0\u52a8\u91cc\u5939\u6742\u7740\u5