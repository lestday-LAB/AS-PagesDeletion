Backrooms\";\n    --header-subtitle: \"\u4f60\u66fe\u7ecf\u6765\u8fc7\u8fd9\u91cc\";\n    --accent-color: 218,165,32; /* \u4e3b\u9898\u8272 */\n    --background-image: url(\"https://imgurl.diadi.cn/imgs/2026/07/6f1510c839b9b5b7.png\");\n}\n[[/module]]\n\n\n[[>]]\n[[module Rate]]\n[[/>]]\n@@@@\n[[include :backrooms-wiki-cn:component:xilevelclass\n|lang=cn\n|res=5\n|ext=1\n|env=1\n|ent=0\n]]\n@@@@\n**Level AS-302** \u662f\u540e\u5ba4AS\u5c42\u7fa4\u7684\u7b2c303\u5c42\u3002\n@@@@\n+ \u63cf\u8ff0\nLevel AS-302 \u7531\u4e00\u7247\u5145\u6ee1\u4e00\u79cd\u672a\u77e5\u6db2\u4f53\u7684\u6d77\u6d0b\uff08\u4ee5\u4e0b\u79f0\u4f5c\u201c\u7a7a\u57df\u201d\uff09\u53ca\u4e00\u5ea7\u60ac\u6d6e\u4e8e\u5176\u4e0a\u7684\u5de8\u578b\u900f\u660e\u697c\u68af\u7ec4\u6210\u3002\u622a\u81f3\u76ee\u524d\uff0c\u672a\u53d1\u73b0\u8be5\u5c42\u7ea7\u5b58\u5728\u8fb9\u754c\u3002\u6d41\u6d6a\u8005\u5207\u5165\u8be5\u5c42\u7ea7\u65f6\u9762\u5411\u7684\u65b9\u5411\u603b\u662f\u6052\u5b9a\u7684\u3002\u5c42\u7ea7\u7684\u5149\u6e90\u4f4d\u4e8e\u5c42\u7ea7\u53f3\u4e0a\u65b9[[footnote]]\u4ee5\u6d41\u6d6a\u8005\u5207\u5165\u5c42\u7ea7\u65f6\u9762\u5411\u7684\u65b9\u5411\u4e3a\u57fa\u51c6[[/footnote]]\uff0c\u5448\u6a21\u7cca\u7684\u7403\u72b6\u60ac\u6d6e\u5728\u9065\u8fdc\u7684\u7a7a\u4e2d\uff0c\u5176\u6696\u767d\u8272\u7684\u5149\u8292\u5c06\u6574\u4e2a\u5c42\u7ea7\u7a7a\u95f4\u6655\u67d3\u6210\u6e29\u548c\u660e\u4eae\u7684\u6696\u8272\u8c03\u3002\u5149\u6e90\u6240\u5728\u4e4b\u5904\u88ab\u8ba4\u4e3a\u662f\u4e0d\u53ef\u5230\u8fbe\u7684\u3002\u5c42\u7ea7\u5185\u90e8\u6e29\u5ea6\u7a33\u5b9a\u572812\u2103\u5de6\u53f3\uff0c\u6e7f\u5ea6\u7ea6\u4e3a70%\uff0c\u4f53\u611f\u4e0a\u7c7b\u4f3c\u66ae\u6625\u65f6\u8282\u4e2d\u56fd\u5317\u65b9\u7684\u65e9\u6668\u3002\n\n\u5c42\u7ea7\u5185\u90e8\u4e0d\u5b58\u5728\u4efb\u4f55\u53ef\u7528\u7269\u8d44\uff0c\u56e0\u6b64\u5efa\u8bae\u8fdb\u5165\u8be5\u5c42\u7ea7\u7684\u6d41\u6d6a\u8005\u5c3d\u5feb\u79bb\u5f00\u2014\u2014\u5c3d\u7ba1\u8be5\u5c42\u7ea7\u7684\u751f\u5b58\u96be\u5ea6\u7b49\u7ea7\u8f83\u4f4e\uff0c\u4f46\u8d44\u6e90\u7684\u532e\u4e4f\u672c\u8eab\u5373\u662f\u5371\u9669\u3002\n\n++ \u697c\u68af\n\n\u5c42\u7ea7\u7684\u4e3b\u4f53\u4e3a\u4e00\u5ea7\u60ac\u6d6e\u5728\u7a7a\u4e2d\u7684\u5de8\u5927\u697c\u68af\u3002\u5176\u901a\u4f53\u900f\u660e\uff0c\u4e14\u6c38\u8fdc\u4e00\u5c18\u4e0d\u67d3\u2014\u2014\u4efb\u4f55\u9644\u7740\u5728\u5176\u8868\u9762\u7684\u6c61\u6e0d\u90fd\u4f1a\u5f88\u5feb\u6d88\u5931\u3002\u6784\u6210\u5176\u7684\u900f\u660e\u6750\u6599\u8d28\u5730\u7c7b\u4f3c\u73bb\u7483\uff0c\u5374\u6781\u5176\u575a\u786c\uff0c\u76ee\u524d\u8ba4\u4e3a\u5176\u4e0d\u53ef\u88ab\u7834\u574f\u3002\u697c\u68af\u6ca1\u6709\u6276\u624b\uff0c\u4ec5\u7531\u4e00\u5c42\u5c42\u5ef6\u4f38\u7684\u68af\u7ea7\u7ec4\u6210\u3002\u5b83\u4eec\u7684\u5ef6\u4f38\u65b9\u5411\u5e76\u4e0d\u56fa\u5b9a\uff0c\u65f6\u800c\u5411\u4e0a\uff0c\u65f6\u800c\u5411\u4e0b\uff0c\u65f6\u800c\u8f6c\u5f2f\uff0c\u65f6\u800c\u87ba\u65cb\u3002\u7ec6\u770b\uff0c\u5219\u4f1a\u53d1\u73b0\u697c\u68af\u8868\u9762\u5e76\u4e0d\u5b8c\u5168\u5149\u6ed1\uff0c\u800c\u662f\u5e03\u6ee1\u4e86\u523b\u75d5\u7eb9\u8def\u3002\u5b83\u4eec\u987a\u7740\u68af\u7ea7\u8513\u5ef6\uff0c\u626d\u66f2\u6210\u4e0d\u660e\u542b\u4e49\u7684\u5de8\u5927\u56fe\u6848\u94fa\u6ee1\u6574\u5ea7\u697c\u68af\u3002\u8fd9\u4e9b\u7eb9\u8def\u7684\u5b58\u5728\u4f3c\u4e4e\u4e0e\u6784\u6210\u697c\u68af\u7684\u6750\u6599\u786c\u5ea6\u6781\u5927\u7684\u6027\u8d28\u76f8\u77db\u76fe\uff0c\u76ee\u524d\u5c1a\u4e0d\u77e5\u5176\u6210\u56e0\u3002\u867d\u7136\u5c42\u7ea7\u65e0\u8fb9\u65e0\u9645\uff0c\u4f46\u697c\u68af\u5374\u662f\u5b58\u5728\u8fb9\u754c\u7684[[footnote]]\u7531\u4e8e\u697c\u68af\u8fc7\u4e8e\u5e9e\u5927\uff0c\u63a2\u6d4b\u5176\u5177\u4f53\u7684\u5927\u5c0f\u4e0e\u6784\u6210\u5176\u7684\u68af\u7ea7\u6570\u91cf\u88ab\u8ba4\u4e3a\u662f\u65e0\u610f\u4e49\u7684\u3002[[/footnote]]\u3002\u66fe\u6709\u6d41\u6d6a\u8005\u5728\u5207\u5165\u8be5\u5c42\u7ea7\u65f6\u76f4\u63a5\u51fa\u73b0\u5728\u4e86\u697c\u68af\u7684\u5c3d\u5934\uff0c\u90a3\u4e00\u7ea7\u9636\u68af\u4e0e\u5176\u5b83\u9636\u68af\u5e76\u65e0\u4efb\u4f55\u5dee\u522b\u3002\n\n\u697c\u68af\u533a\u57df\u4e3a\u6b63\u5e38\u7a7a\u6c14\u73af\u5883\u3002\u8584\u8584\u7684\u96fe\u6c14\u5728\u7a7a\u95f4\u91cc\u5f25\u6f2b\u5f00\u6765\uff0c\u5982\u540c\u524d\u5385\u4e2d\u7684\u6668\u96fe\u4e00\u822c\u5c06\u5149\u5747\u5300\u5730\u6563\u5c04\u5230\u5404\u5904\uff0c\u7559\u4e0b\u4e00\u9053\u56e0\u4e01\u8fbe\u5c14\u6548\u5e94\u800c\u4ea7\u751f\u7684\u660e\u4eae\u5149\u8def\u3002\u8fdc\u65b9\u7684\u7a7a\u4e2d\u98d8\u6d6e\u7740\u51e0\u7247\u5149\u6655\uff0c\u5b83\u4eec\u4e00\u523b\u4e0d\u505c\u5730\u6d41\u8f6c\u53d8\u5e7b\uff0c\u5b9b\u5982\u68a6\u5883\u3002\u65e0\u8bba\u6d41\u6d6a\u8005\u8eab\u5904\u4f55\u5730\uff0c\u5b83\u4eec\u603b\u662f\u51fa\u73b0\u5728\u6d41\u6d6a\u8005\u7684\u89c6\u7ebf\u5c3d\u5934\u3002\n\n\u6d41\u6d6a\u8005\u5728\u5207\u5165\u8be5\u5c42\u7ea7\u65f6\uff0c\u603b\u4f1a\u968f\u673a\u51fa\u73b0\u5728\u4e00\u7ea7\u697c\u68af\u4e0a\u3002\u4e4b\u540e\uff0c\u6d41\u6d6a\u8005\u6bcf\u8e0f\u4e0a\u4e00\u7ea7\u697c\u68af\uff0c\u5c31\u4f1a\u6709\u4e00\u5c0f\u6bb5\u8f7b\u67d4\u7684\u97f3\u4e50\u5728\u5c42\u7ea7\u4e2d\u54cd\u8d77\u3002\u97f3\u4e50\u58f0\u7684\u6765\u6e90\u65e0\u6cd5\u8fa8\u8ba4\uff0c\u56e0\u4e3a\u97f3\u91cf\u7684\u5927\u5c0f\u4e0d\u4f1a\u968f\u6d41\u6d6a\u8005\u6240\u5904\u7684\u4f4d\u7f6e\u6539\u53d8\u3002\u4e8b\u5b9e\u4e0a\uff0c\u5176\u66f4\u50cf\u662f\u201c\u5728\u81ea\u5df1\u8111\u5b50\u91cc\u54cd\u8d77\u6765\u7684\u201d[[footnote]]\u6765\u81ea\u4e00\u4f4d\u6d41\u6d6a\u8005\u7684\u63cf\u8ff0[[/footnote]]\u3002\u636e\u5207\u5165\u8be5\u5c42\u7ea7\u7684\u6d41\u6d6a\u8005\u6240\u8ff0\uff0c\u97f3\u4e50\u7247\u6bb5\u5747\u8282\u9009\u81ea\u524d\u5385\u97f3\u4e50\u300aIllusionary Daytime\uff08\u5e7b\u663c\uff09\u300b\u3002\n\n\u6709\u4e9b\u697c\u68af\u7684\u8fb9\u7f18\u7acb\u7740\u4e00\u6247\u900f\u660e\u7684\u95e8\u3002\u95e8\u7684\u6750\u8d28\u4e0e\u697c\u68af\u4e00\u81f4\uff0c\u5176\u540e\u7684\u666f\u8c61\u4e00\u7247\u6726\u80e7\u3002\u8d70\u8fdb\u95e8\u5373\u53ef\u79bb\u5f00\u8be5\u5c42\u7ea7\u3002\n\n\u5076\u5c14\u697c\u68af\u4e0a\u4f1a\u51fa\u73b0\u4e00\u4e2a\u4eba\u5f71\uff0c\u5916\u5f62\u4e3a\u4e00\u540d\u5c11\u5973\u3002\u5176\u8eab\u9ad8\u7ea6\u4e3a155cm\uff0c\u4f53\u578b\u504f\u7626\uff0c\u9ed1\u8272\u957f\u53d1\u62ab\u80a9\uff0c\u9762\u5bb9\u6c38\u8fdc\u6a21\u7cca\u4e0d\u6e05\u3002\u5176\u8eab\u7740\u4e00\u88ad\u8fc7\u819d\u767d\u88d9\uff0c\u6b63\u62fe\u7ea7\u800c\u4e0a\u6291\u6216\u662f\u7ad9\u5b9a\u4ef0\u671b\u3002\u5176\u4e0d\u5b58\u5728\u5b9e\u4f53\uff0c\u6d41\u6d6a\u8005\u65e0\u6cd5\u4ee5\u4efb\u4f55\u65b9\u5f0f\u4e0e\u5176\u8fdb\u884c\u4ea4\u4e92\u3002\u4eba\u5f71\u7ad9\u5b9a\u7684\u68af\u7ea7\u65c1\u5f80\u5f80\u5b58\u5728\u4e0a\u8ff0\u7684\u51fa\u53e3\u95e8\uff0c\u56e0\u6b64\u5efa\u8bae\u89c2\u6d4b\u5230\u8be5\u4eba\u5f71\u7684\u6d41\u6d6a\u8005\u8ddf\u968f\u5176\u4ee5\u5c3d\u5feb\u627e\u5230\u51fa\u53e3\u3002\n\n\n++ \u7a7a\u57df\n\n\u82e5\u6d41\u6d6a\u8005\u4e0d\u614e\u4ece\u697c\u68af\u4e0a\u8dcc\u843d\uff0c\u6700\u7ec8\u5c06\u4f1a\u5760\u5165\u7a7a\u57df\u3002\u6709\u4e9b\u68af\u7ea7\u76f4\u63a5\u6f02\u6d6e\u5728\u7a7a\u57df\u4e4b\u4e0a\uff0c\u722c\u4e0a\u8fd9\u4e9b\u68af\u7ea7\u5373\u53ef\u79bb\u5f00\u7a7a\u57df\uff0c\u56de\u5230\u697c\u68af\u533a\u57df\u3002\n\n\u4fef\u89c6\u7a7a\u57df\uff0c\u53ef\u4ee5\u770b\u5230\u5176\u8868\u9762\u9ad8\u4f4e\u4e0d\u5e73\uff0c\u5e03\u6ee1\u6df1\u6df1\u6d45\u6d45\u7684\u7eb9\u8def\uff0c\u5f62\u6210\u4e00\u9053\u72ec\u7279\u7684\u666f\u89c2\u3002\u8fd9\u4e9b\u7eb9\u8def\u4e0e\u697c\u68af\u4e0a\u7684\u7eb9\u8def\u4f3c\u4e4e\u5b58\u5728\u67d0\u79cd\u5bf9\u5e94\u5173\u7cfb\uff0c\u5176\u6210\u56e0\u540c\u6837\u672a\u77e5\u3002\n\n\u6574\u4e2a\u7a7a\u57df\u88ab\u4e00\u79cd\u672a\u77e5\u6db2\u4f53\u586b\u6ee1\uff08\u4e0b\u79f0\u201c\u5e7b\u6db2\u201d\uff09\u3002\u5176\u900f\u5149\u7387\u7565\u4f4e\u4e8e\u7a7a\u6c14\uff0c\u5bc6\u5ea6\u8fd1\u4f3c\u4e8e\u6c34\uff0c\u4f46\u6bd4\u6c34\u66f4\u52a0\u9ecf\u7a20\uff0c\u5728\u5c42\u7ea7\u7684\u5149\u4e0b\u6cdb\u7740\u7425\u73c0\u822c\u6f84\u660e\u6e29\u6696\u7684\u5149\u6cfd\uff0c\u6709\u6d41\u6d6a\u8005\u5f62\u5bb9\u5176\u8d28\u5730\u201c\u597d\u50cf\u63ba\u4e86\u4e9b\u6c34\u7684\u8702\u871c\u201d\u3002\u5176\u4e0d\u53ef\u88ab\u996e\u7528\u3002\u4eba\u53ef\u5728\u5176\u4e2d\u81ea\u7531\u79fb\u52a8\uff0c\u82e5\u9759\u6b62\u4e0d\u52a8\u5219\u4f1a\u7f13\u6162\u4e0b\u6c89\u3002\u5e7b\u6db2\u65e0\u6cd5\u4ee5\u4efb\u4f55\u5f62\u5f0f\u88ab\u5e26\u51fa\u8be5\u5c42\u7ea7\u3002\u76ee\u524d\u7684\u6280\u672f\u624b\u6bb5\u5c1a\u65e0\u6cd5\u63a2\u6d4b\u5e7b\u6db2\u7684\u5176\u4ed6\u6027\u8d28\u3002\n\n\u7a7a\u57df\u4e2d\u60ac\u6d6e\u7740\u5927\u91cf\u7a7a\u6c14\u6c14\u6ce1\uff0c\u8bef\u5165\u7a7a\u57df\u7684\u6d41\u6d6a\u8005\u53ef\u94bb\u5165\u6c14\u6ce1\u4e2d\u4ee5\u547c\u5438\u3002\n\n[[include component:image-block\n |name=https://imgurl.diadi.cn/imgs/2026/07/0ee28c0c638d3664.jpg\n |caption=\u4e00\u5f20\u7a7a\u57df\u7684\u4fef\u62cd\u7167\u7247\u3002\u53ef\u4ee5\u770b\u5230\u5176\u8868\u9762\u7684\u7eb9\u8def\u53ca\u5176\u4e2d\u60ac\u6d6e\u7684\u7a7a\u6c14\u6c14\u6ce1\u3002\n]]\n\n\u8ff7\u5931\u4e8e\u7a7a\u57df\u4e2d\u7684\u6d41\u6d6a\u8005\u6700\u7ec8\u591a\u4f1a\u6b7b\u4e8e\u7a92\u606f\u6216\u9965\u6e34\uff0c\u800c\u8be5\u5c42\u7ea7\u5e76\u6ca1\u6709\u81ea\u52a8\u6e05\u6d01\u673a\u5236\u3002\u56e0\u6b64\uff0c\u7a7a\u57df\u5185\u90e8\u60ac\u6d6e\u7740\u8bb8\u591a\u66fe\u8bef\u5165\u6b64\u5904\u6700\u7ec8\u672a\u80fd\u751f\u8fd8\u7684\u6d41\u6d6a\u8005\u7684\u9057\u4f53\uff0c\u4ee5\u53ca\u4ed6\u4eec\u5e26\u5165\u5c42\u7ea7\u7684\u5404\u79cd\u7269\u54c1\uff0c\u5f53\u7136\u4e5f\u5305\u62ec\u4ed6\u4eec\u5728\u5c42\u7ea7\u5185\u90e8\u4ea7\u751f\u7684\u5e9f\u5f03\u7269\u3002\u4f46\u7531\u4e8e\u7a7a\u57df\u8303\u56f4\u6781\u5176\u5e7f\u5927\uff0c\u8fd9\u4e9b\u4e1c\u897f\u7684\u5b58\u5728\u5e76\u6ca1\u6709\u4f7f\u5f97\u7a7a\u57df\u53d8\u5f97\u6c61\u6d4a\u6742\u4e71\u3002\u8fd9\u4e9b\u60ac\u6d6e\u7684\u9057\u4f53\u4e0d\u4f1a\u8150\u70c2\uff0c\u7269\u54c1\u4e5f\u4e0d\u4f1a\u5206\u89e3\u7834\u788e\uff0c\u4e00\u5207\u90fd\u4e0e\u521a\u521a\u5760\u5165\u6b64\u5730\u65f6\u7684\u6a21\u6837\u4e00\u81f4\uff0c\u4eff\u4f5b\u771f\u7684\u88ab\u51dd\u5728\u4e86\u7425\u73c0\u4e4b\u4e2d\u3002\u6b64\u5916\uff0c\u5728\u7a7a\u57df\u4e2d\u8fd8\u53d1\u73b0\u4e86\u4e24\u5177\u5b9e\u4f53\u9057\u9ab8\uff0c\u63a8\u6d4b\u4e3a\u5916\u90e8\u5c42\u7ea7\u5207\u5165\u7684\u5b9e\u4f53\u3002\n\n\u8d8a\u5411\u4e0b\u5411\u6df1\u5904\uff0c\u7a7a\u57df\u5185\u90e8\u8d8a\u9ed1\u6697\uff0c\u60ac\u6d6e\u7684\u7a7a\u6c14\u6c14\u6ce1\u4e5f\u8d8a\u5c11\u3002\u540c\u65f6\uff0c\u5e7b\u6db2\u5185\u90e8\u5b58\u5728\u7565\u5927\u4e8e\u6c34\u7684\u6db2\u538b\u3002\u7efc\u4e0a\uff0c\u4e0d\u5efa\u8bae\u6d41\u6d6a\u8005\u8d38\u7136\u6df1\u5165\u7a7a\u57df\u63a2\u7d22\u3002\n\n\n++ \u6d8c\u6d41\u73b0\u8c61\n\n\u6d8c\u6d41\u4e3a Level AS-302 \u4e2d\u53d1\u751f\u7684\u4e00\u79cd\u7279\u6b8a\u73b0\u8c61\u3002\u8be5\u73b0\u8c61\u6bcf2\uff5e3\u5c0f\u65f6\u53d1\u751f\u4e00\u6b21\u3002\n\n\u8be5\u73b0\u8c61\u53d1\u751f\u524d\uff0c\u5c42\u7ea7\u5185\u90e8\u73af\u5883\u5f80\u5f80\u4f1a\u51fa\u73b0\u4ee5\u4e0b\u53d8\u5316\uff1a\n\n* \u697c\u68af\u900f\u660e\u5ea6\u964d\u4f4e\uff0c\u6784\u6210\u5176\u7684\u6750\u6599\u5185\u90e8\u53d8\u5f97\u7070\u6697\u6d51\u6d4a\uff1b\n* \u6d41\u6d6a\u8005\u8e0f\u4e0a\u697c\u68af\u65f6\u64ad\u653e\u7684\u97f3\u4e50\u51fa\u73b0\u5361\u987f\u3001\u5931\u771f\uff1b\n* \u697c\u68af\u4e0a\u5c11\u5973\u7684\u5e7b\u5f71\u95ea\u70c1\u4e0d\u5b9a\uff1b\n* \u7a7a\u57df\u8868\u9762\u6cdb\u8d77\u6ce2\u6d6a\u3002\n\n\u4e0a\u8ff0\u73b0\u8c61\u4f1a\u6301\u7eed5~10\u5206\u949f\uff0c\u968f\u540e\u5c42\u7ea7\u51fa\u5165\u53e3\u5c06\u5c01\u95ed\u3002\u8fd9\u6807\u5fd7\u7740\u6d8c\u6d41\u73b0\u8c61\u5f00\u59cb\u3002\n\n\u6b64\u65f6\uff0c\u7a7a\u57df\u4e2d\u7684\u5e7b\u6db2\u4f1a\u81ea\u90a3\u4e9b\u76f4\u63a5\u6f02\u6d6e\u4e8e\u5176\u4e0a\u7684\u68af\u7ea7\u6500\u7f18\u81f3\u697c\u68af\u8868\u9762\uff0c\u6e17\u5165\u697c\u68af\u8868\u9762\u4e00\u9053\u9053\u7eb9\u8def\u4e4b\u4e2d\uff0c\u53c8\u987a\u7740\u5b83\u4eec\u98de\u901f\u8513\u5ef6\uff0c\u76f4\u81f3\u6574\u5ea7\u697c\u68af\u8868\u9762\u6240\u6709\u7684\u7eb9\u8def\u90fd\u88ab\u5e7b\u6db2\u586b\u6ee1\u3002\u8fdc\u8fdc\u671b\u53bb\uff0c\u697c\u68af\u5982\u540c\u88ab\u4e00\u6761\u6761\u7425\u73c0\u8272\u7684\u4e1d\u7ebf\u7d27\u7d27\u7f20\u7ed5\uff0c\u53c8\u597d\u4f3c\u5176\u4e0a\u751f\u51fa\u4e86\u65e0\u6570\u6839\u6cdb\u7740\u91d1\u5149\u7684\u65b0\u751f\u8840\u7ba1\u3002\u8fd9\u79cd\u72b6\u6001\u5c06\u6301\u7eed10\u81f320\u5206\u949f\u4e0d\u7b49\u3002\n\n\u968f\u540e\uff0c\u697c\u68af\u5c06\u4f1a\u9010\u6e10\u5438\u6536\u9644\u7740\u5728\u5176\u4e0a\u7684\u5e7b\u6db2\uff0c\u76f4\u81f3\u6784\u6210\u697c\u68af\u7684\u6750\u6599\u5185\u90e8\u4e5f\u88ab\u5b8c\u5168\u67d3\u6210\u6de1\u6de1\u7684\u7425\u73c0\u8272\u3002\u5927\u7ea610\u5206\u949f\u4e4b\u540e\uff0c\u697c\u68af\u7684\u989c\u8272\u5c06\u6e10\u6e10\u892a\u53bb\uff0c\u6700\u540e\u6062\u590d\u5230\u5e72\u51c0\u900f\u660e\u7684\u72b6\u6001\u3002\u6b64\u65f6\u5c42\u7ea7\u5185\u90e8\u73af\u5883\u5c06\u5b8c\u5168\u6062\u590d\u6b63\u5e38\uff0c\u51fa\u5165\u53e3\u4e5f\u5c06\u91cd\u65b0\u5f00\u653e\uff0c\u6d8c\u6d41\u73b0\u8c61\u7ed3\u675f\u3002\n\n\u6d8c\u6d41\u73b0\u8c61\u53d1\u751f\u7684\u6574\u4e2a\u8fc7\u7a0b\u4e2d\uff0c\u5c42\u7ea7\u5185\u90e8\u5c06\u4e0d\u95f4\u65ad\u5730\u5faa\u73af\u64ad\u653e\u300aIllusionary Daytime\uff08\u5e7b\u663c\uff09\u300b\uff0c\u5176\u58f0\u97f3\u6765\u6e90\u540c\u6837\u672a\u77e5\u3002\u6b64\u65f6\u7684\u97f3\u4e50\u58f0\u6781\u8f7b\uff0c\u5374\u4ecd\u65e7\u6e05\u6670\u53ef\u8fa8\uff0c\u5982\u540c\u5c42\u7ea7\u5185\u90e8\u90a3\u5c42\u6de1\u6de1\u7684\u8584\u96fe\u5f25\u6563\u5728\u6574\u4e2a\u7a7a\u95f4\u91cc\u3002\u6709\u8bc1\u636e\u8868\u660e\u5176\u5bf9\u6d41\u6d6a\u8005\u6709\u79ef\u6781\u7cbe\u795e\u5f71\u54cd\uff0c\u5177\u4f53\u8868\u73b0\u4e3a\u80fd\u4f7f\u4eba\u611f\u5230\u653e\u677e\uff0c\u5e26\u7ed9\u4eba\u4e00\u79cd\u201c\u6cbb\u6108\u201d\u201c\u5145\u6ee1\u80fd\u91cf\u201d[[footnote]]\u5747\u91c7\u81ea\u4eb2\u5386\u8be5\u73b0\u8c61\u7684\u6d41\u6d6a\u8005\u53e3\u8ff0[[/footnote]]\u7684\u611f\u53d7\u3002\n\n\u76ee\u524d\u8ba4\u4e3a\uff0c\u6d8c\u6d41\u73b0\u8c61\u5f88\u53ef\u80fd\u662f\u8be5\u5c42\u7ea7\u7684\u4e00\u79cd\u201d\u5145\u80fd\u201c\u673a\u5236\u3002\u5e7b\u6db2\u4e2d\u53ef\u80fd\u5305\u542b\u67d0\u79cd\u672a\u77e5\u6210\u5206\uff0c\u8fd9\u79cd\u6210\u5206\u53ef\u4ee5\u7ef4\u6301\u5176\u4e0a\u65b9\u6574\u4e2a\u697c\u68af\u533a\u57df\u7684\u6b63\u5e38\u73af\u5883\uff0c\u4f7f\u5176\u4e0d\u81f3\u8d70\u5411\u52a3\u5316\u3002[[footnote]]\u4e00\u4f4d\u7814\u7a76\u8005\u5c06\u6d8c\u6d41\u73b0\u8c61\u79f0\u4f5c\u201d\u4e00\u7247\u6d77\u6d0b\u54fa\u80b2\u4e86\u5176\u4e0a\u7684\u4e00\u6574\u4e2a\u5e7b\u5883\u201c\u3002[[/footnote]]\u8fd8\u6709\u63a8\u6d4b\u8ba4\u4e3a\uff0c\u5e7b\u6db2\u963b\u6b62\u52a3\u5316\uff0c\u4fdd\u5b58\u539f\u59cb\u72b6\u6001\u7684\u6027\u8d28\u4e0d\u4ec5\u80fd\u4f5c\u7528\u4e8e\u697c\u68af\u533a\u57df\uff0c\u4e5f\u80fd\u4f5c\u7528\u4e8e\u5176\u4ed6\u6240\u6709\u4e0e\u5176\u957f\u65f6\u95f4\u63a5\u89e6\u4e4b\u7269\u3002\u8fd9\u6216\u8bb8\u80fd\u89e3\u91ca\u4e0a\u6587\u6240\u8ff0\u7684\u7279\u6027\u4e3a\u4f55\u4ea7\u751f\u2014\u2014\u7a7a\u57df\u4e2d\u60ac\u6d6e\u7740\u7684\u4e00\u5207\u6c38\u8fdc\u4fdd\u6301\u7740\u521a\u521a\u5760\u5165\u5176\u4e2d\u65f6\u7684\u72b6\u6001\uff0c\u6c38\u4e0d\u673d\u70c2\u3002\n\n\n+ \u5b9e\u4f53\n\u8be5\u5c42\u7ea7\u4e0d\u5b58\u5728\u4efb\u4f55\u539f\u751f\u5b9e\u4f53\uff0c\u4f46\u6781\u5c11\u6570\u60c5\u51b5\u4e0b\u4f1a\u6709\u6765\u81ea\u5176\u4ed6\u5c42\u7ea7\u7684\u5b9e\u4f53\u5207\u5165\u8be5\u5c42\u7ea7\u3002\n@@@@\n+ \u57fa\u5730\uff0c\u524d\u54e8\u4e0e\u793e\u533a\n\u7531\u4e8e\u8be5\u5c42\u7ea7\u7684\u7269\u8d44\u532e\u4e4f\u6027\uff0c\u8be5\u5c42\u7ea7\u5185\u4e0d\u5b58\u5728\u4efb\u4f55\u57fa\u5730\uff0c\u524d\u54e8\u4e0e\u793e\u533a\u3002\n@@@@\n+ \u5165\u53e3\u4e0e\u51fa\u53e3\n++ \u5165\u53e3\n\u8d70\u8fdb [[[Level AS-44]]] \u4e2d\u4e00\u6247\u6cdb\u7740\u91d1\u5149\u7684