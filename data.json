684\u4e91\u5c42\uff0c\u4e0d\u5b58\u5728\u4efb\u4f55\u81ea\u7136\u5929\u4f53\uff0c\u5176\u4e2d\u5305\u62ec\u6708\u4eae\u4e0e\u592a\u9633\u3002\u6574\u4e2a\u5c42\u7ea7\u88ab\u4e00\u79cd\u6781\u7aef\u7684\u3001\u538b\u6291\u7684\u5bc2\u9759\u6240\u7b3c\u7f69\uff0c\u9664\u4e86\u98ce\u7684\u547c\u5578\u3001\u8def\u706f\u7684\u7535\u6d41\u55e1\u9e23\u4ee5\u53ca\u5b9e\u4f53\u53d1\u51fa\u7684\u65e0\u610f\u4e49\u7ab8\u7aa3\u58f0\u5916\uff0c\u7f3a\u4e4f\u73b0\u4ee3\u90fd\u5e02\u5e94\u6709\u7684\u73af\u5883\u767d\u566a\u97f3\u3002\n\n\u8be5\u5c42\u7ea7\u88ab\u8bc1\u5b9e\u5728\u7269\u7406\u7ef4\u5ea6\u4e0a\u5177\u6709\u65e0\u9650\u5ef6\u5c55\u7684\u7279\u6027\uff0c\u5176\u5730\u7406\u666f\u89c2\u7531\u5bbd\u9614\u7684\u67cf\u6cb9\u9a6c\u8def\u3001\u4eba\u884c\u9053\u3001\u9519\u843d\u7684\u4f4e\u5c42\u4f4f\u5b85\u697c\u3001\u516c\u5bd3\u7fa4\u4ee5\u53ca\u96f6\u661f\u5206\u5e03\u7684\u4e34\u8857\u5546\u94fa\u6784\u6210\u3002\u7136\u800c\uff0c\u8fd9\u79cd\u6784\u56fe\u867d\u7136\u8574\u542b\u7740\u6d53\u70c8\u7684\u73b0\u4ee3\u6587\u660e\u6c14\u606f\uff0c\u5374\u9690\u533f\u7740\u6781\u5927\u7684\u7269\u7406\u6cd5\u5219\u5f02\u5e38\u4e0e\u611f\u5b98\u9677\u9631\u3002\n\n++ \u5f02\u5e38\u6027\u8d28\n[[include component:image-block\n|name=http://r-sandbox-cn.wikidot.com/local--files/la:level-ui-13/photo-1619057051944-7d05ec771418.jpeg\n|caption=\u53e6\u4e00\u5f20\u56fe\u7247\u3002\n|align=left\n]]\n\u8fd9\u4e00\u7a7a\u95f4\u6700\u5371\u9669\u7684\u7279\u5f81\u5728\u4e8e\u5176\u201c\u4e0d\u7a33\u5b9a\u6027\u201d\u3002\u7ecf\u591a\u6b21\u52d8\u63a2\u786e\u8ba4\uff0c\u8be5\u5c42\u7ea7\u7684\u7a7a\u95f4\u62d3\u6251\u7ed3\u6784\u4f1a\u53d1\u751f\u65e0\u89c4\u5f8b\u7684\u5207\u6362\u4e0e\u91cd\u7ec4\u3002\u5f53\u6d41\u6d6a\u8005\u7a7f\u884c\u4e8e\u72ed\u7a84\u7684\u793e\u533a\u5df7\u9053\uff0c\u6216\u6cbf\u7740\u9a6c\u8def\u72ec\u81ea\u524d\u884c\u65f6\uff0c\u5468\u56f4\u7684\u5efa\u7b51\u5e03\u5c40\u4f1a\u5728\u4e0d\u7ecf\u610f\u95f4\u53d1\u751f\u7269\u7406\u4e0a\u7684\u201c\u5e73\u79fb\u201d\u6216\u201c\u574d\u7f29\u201d\u3002\u4f8b\u5982\uff0c\u539f\u672c\u4f4d\u4e8e\u8857\u89d2\u7684\u5546\u5e97\u4f1a\u5728\u4e00\u4e2a\u7728\u773c\u95f4\u88ab\u4e00\u680b\u7a81\u5140\u7684\u516c\u5bd3\u697c\u6240\u66ff\u4ee3\uff1b\u66fe\u7ecf\u987a\u76f4\u7684\u8857\u9053\uff0c\u4f1a\u5728\u56de\u5934\u89c2\u5bdf\u7684\u77ac\u95f4\u53d8\u6210\u4e00\u4e2a\u65e0\u6cd5\u901a\u884c\u7684\u6b7b\u80e1\u540c\u3002\u8fd9\u79cd\u91cd\u7ec4\u8fc7\u7a0b\u5f80\u5f80\u662f\u65e0\u58f0\u4e14\u6ca1\u6709\u53ef\u89c6\u8fc7\u6e21\u7684\uff0c\u5bfc\u81f4\u6d41\u6d6a\u8005\u6781\u6613\u5728\u9519\u7efc\u590d\u6742\u7684\u591c\u665a\u8857\u9053\u4e2d\u5f7b\u5e95\u8ff7\u5931\u65b9\u5411\uff0c\u4e14\u65e0\u6cd5\u786e\u8ba4\u81ea\u5df1\u6240\u5904\u5750\u6807\u7684\u76f8\u5bf9\u5b89\u5168\u6027\u3002\n\n\u8be5\u5c42\u7ea7\u7684\u5149\u6e90\u4e25\u91cd\u53d7\u9650\uff0c\u4e14\u5177\u6709\u5f02\u5e38\u7684\u6295\u5c04\u7279\u6027\u3002\u6574\u4e2a\u201c\u65e0\u5c3d\u7684\u591c\u665a\u201d\u4ec5\u4f9d\u9760\u8def\u706f\u3001\u4e00\u697c\u4f4f\u6237\u7a97\u6237\u900f\u51fa\u7684\u5fae\u8584\u706f\u5149\u4ee5\u53ca\u4e2a\u522b\u5e97\u94fa\u7684\u62db\u724c\u7167\u660e\u3002\u8def\u706f\u7684\u706f\u5149\u5448\u73b0\u51fa\u523a\u76ee\u7684\u51b7\u767d\u8272\u6216\u504f\u9ec4\u7684\u8272\u8c03\uff0c\u5149\u7ebf\u5728\u6f6e\u6e7f\u7684\u67cf\u6cb9\u8def\u9762\u548c\u4f4e\u77ee\u7684\u7eff\u5316\u704c\u6728\u4e0a\u6295\u5c04\u51fa\u6781\u4e3a\u9510\u5229\u7684\u9634\u5f71\u3002\u9700\u8981\u7279\u522b\u6ce8\u610f\u7684\u662f\uff0c\u8fd9\u4e9b\u8def\u706f\u7684\u5149\u6591\u5e76\u4e0d\u7b26\u5408\u5e38\u89c4\u7269\u7406\u89c4\u5f8b\uff0c\u5176\u8986\u76d6\u8303\u56f4\u65f6\u5e38\u53d1\u751f\u975e\u6b27\u51e0\u4f55\u5f0f\u7684\u7578\u53d8\uff0c\u5bfc\u81f4\u5728\u7279\u5b9a\u7684\u9634\u5f71\u5939\u89d2\u4e2d\uff0c\u7269\u7406\u7a7a\u95f4\u4e0e\u89c6\u89c9\u7a7a\u95f4\u4ea7\u751f\u9519\u4f4d\uff0c\u6d41\u6d6a\u8005\u53ef\u80fd\u5728\u8fd9\u4e9b\u88ab\u5149\u201c\u9057\u5fd8\u201d\u7684\u76f2\u533a\u4e2d\u63a5\u89e6\u5230\u4e0d\u53ef\u89c1\u7684\u5b9e\u4f53\u3002\n\n\u8be5\u5c42\u7ea7\u5efa\u7b51\u7684\u5185\u90e8\u7a7a\u95f4\u540c\u6837\u662f\u4e00\u4e2a\u5de8\u5927\u7684\u9677\u9631\u3002\u95e8\u524d\u7684\u53f0\u9636\u6216\u7a97\u6237\u5f80\u5f80\u5904\u4e8e\u53ef\u8fdb\u5165\u72b6\u6001\uff0c\u7136\u800c\u4e00\u65e6\u6b65\u5165\u5176\u5185\u90e8\uff0c\u6d41\u6d6a\u8005\u5c06\u9762\u4e34\u4e00\u79cd\u5e7d\u95ed\u7684\u9519\u4e71\u611f\u3002\u623f\u5c4b\u5185\u90e8\u5448\u73b0\u51fa\u4e00\u79cd\u5b8c\u5168\u201c\u4eba\u4ea1\u697c\u7a7a\u201d\u7684\u5e9f\u589f\u611f\uff0c\u6ee1\u662f\u79ef\u5c18\u7684\u5bb6\u5177\u3001\u7c98\u7a20\u7684\u6c61\u6e0d\u4ee5\u53ca\u65e0\u6cd5\u6253\u5f00\u7684\u65e7\u5f0f\u5bb6\u7535\u3002\u8fd9\u4e9b\u5efa\u7b51\u4e0d\u5b58\u5728\u5e38\u89c4\u610f\u4e49\u4e0a\u7684\u907f\u96be\u4f5c\u7528\uff0c\u56e0\u4e3a\u5b9e\u4f53\u5f80\u5f80\u80fd\u591f\u4ee5\u66f4\u5177\u4f18\u52bf\u7684\u65b9\u5f0f\u6e17\u900f\u8fdb\u6765\u3002\u6b64\u5916\uff0c\u8be5\u5c42\u7ea7\u5b58\u5728\u67d0\u79cd\u4f4e\u5f3a\u5ea6\u7684\u5fc3\u7406\u4fb5\u8680\u6548\u5e94\uff0c\u957f\u671f\u5f98\u5f8a\u4e8e\u6b64\u7684\u6d41\u6d6a\u8005\u4f1a\u611f\u5230\u4e00\u79cd\u5f3a\u70c8\u7684\u3001\u5bbf\u547d\u822c\u7684\u5b64\u72ec\u611f\u548c\u65f6\u95f4\u505c\u6ede\u611f\uff0c\u751a\u81f3\u4ea7\u751f\u5e7b\u89c9\uff0c\u9690\u7ea6\u542c\u5230\u8fdc\u5904\u4f20\u6765\u6839\u672c\u4e0d\u5b58\u5728\u7684\u4eba\u58f0\u6216\u72ac\u5420\u3002\n\n++ \u5b9e\u4f53 \n\u8be5\u5c42\u7ea7\u5185\u6d3b\u8dc3\u7740\u4e2d\u91cf\u7684\u5b9e\u4f53\uff0c\u8fd9\u4e9b\u5b9e\u4f53\u901a\u5e38\u9690\u85cf\u5728\u704c\u6728\u4e1b\u7684\u6697\u9762\u3001\u5e9f\u5f03\u8f66\u8f86\u7684\u540e\u6392\u3001\u6216\u662f\u90a3\u4e9b\u706f\u5149\u5931\u6548\u7684\u6b7b\u89d2\u4e4b\u4e2d\u3002\u5df2\u77e5\u7684\u5a01\u80c1\u5305\u62ec\uff1a\n\n* **\u7a83\u76ae\u8005**\u4e0e**\u730e\u72ac**\uff1a\u5b83\u4eec\u6700\u5e38\u51fa\u73b0\u5728\u8fde\u63a5\u5c45\u6c11\u533a\u7684\u72ed\u7a84\u8857\u9053\u4e0a\u3002\u7531\u4e8e\u5176\u6781\u9ad8\u7684\u673a\u52a8\u6027\u4e0e\u6f5c\u4f0f\u80fd\u529b\n\n* **\u7b11\u9b47\uff1a**\u5e7f\u6cdb\u5b58\u5728\u4e8e\u90a3\u4e9b\u5b8c\u5168\u9694\u7edd\u4e86\u6240\u6709\u5149\u6e90\u7684\u5efa\u7b51\u7269\u6df1\u5904\u3001\u5730\u4e0b\u8f66\u5e93\u5165\u53e3\uff0c\u6216\u8005\u8def\u706f\u7a81\u7136\u96c6\u4f53\u7184\u706d\u7684\u9053\u8def\u6bb5\u3002\n\n* **\u60b2\u5c38\uff1a**\u5076\u5c14\u4f1a\u5728\u8be5\u5c42\u7ea7\u7684\u4e00\u4e9b\u770b\u4f3c\u5e73\u9759\u7684\u957f\u51f3\u9644\u8fd1\uff0c\u6216\u72ec\u680b\u623f\u5c4b\u7684\u660f\u6697\u95e8\u5eca\u5904\u88ab\u76ee\u51fb\uff0c\u5b83\u4eec\u901a\u5e38\u5904\u4e8e\u65e0\u610f\u8bc6\u7684\u4f4e\u541f\u72b6\u6001\uff0c\u4f46\u4e00\u65e6\u53d7\u5230\u60ca\u6270\uff0c\u4f1a\u8868\u73b0\u51fa\u6781\u5f3a\u7684\u653b\u51fb\u6027\u3002\n\n* **\u7279\u6b8a\u62a5\u544a\uff1a**\u6709\u96f6\u661f\u7684\u62a5\u544a\u6307\u51fa\uff0c\u5728\u8fdc\u79bb\u5149\u6e90\u7684\u6781\u8fdc\u5904\uff0c\u66fe\u76ee\u51fb\u4e00\u79cd\u4e0e\u8def\u706f\u706f\u67f1\u9ad8\u5ea6\u878d\u5408\u7684\u7ec6\u957f\u4eba\u5f62\u5b9e\u4f53\uff0c\u5728\u8857\u9053\u5c3d\u5934\u7f13\u6162\u79fb\u52a8\u3002\u7531\u4e8e\u8ddd\u79bb\u8fc7\u8fdc\u4e14\u5149\u7ebf\u4e0d\u8db3\uff0c\u5176\u786e\u5207\u5f62\u6001\u548c\u5a01\u80c1\u7a0b\u5ea6\u5c1a\u5f85\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u6d41\u6d6a\u8005\u82e5\u5728\u8857\u89d2\u77a5\u89c1\u6b64\u7c7b\u8f6e\u5ed3\uff0c\u5e94\u7acb\u523b\u79fb\u5f00\u89c6\u7ebf\u5e76\u671d\u76f8\u53cd\u65b9\u5411\u64a4\u79bb\u3002\n\n+ **\u57fa\u5730\u3001\u524d\u54e8\u4e0e\u793e\u533a**\n\u8be5\u5c42\u7ea7\u6ca1\u6709\u5df2\u77e5\u7684\u57fa\u5730\u3001\u524d\u54e8\u6216\u793e\u533a\u3002\n+ **\u5165\u53e3\u4e0e\u51fa\u53e3**\n++++ \u5165\u53e3\n* \u5728[https://backrooms-wiki-cn.wikidot.com/level-c-28 Level C-28]\u7684\u591c\u95f4\u884c\u9a76\u63a2\u7d22\u4e2d\uff0c\u82e5\u6070\u597d\u7ecf\u8fc7\u67d0\u6761\u6781\u5176\u5b89\u9759\u3001\u8def\u706f\u8001\u5316\u4e14\u5149\u7ebf\u53d1\u6697\u7684\u4f4f\u5b85\u533a\u5c94\u8def\uff0c\u5e76\u6301\u7eed\u6cbf\u7740\u8be5\u8f66\u9053\u884c\u8fdb\uff0c\u5468\u56f4\u7684\u5efa\u7b51\u7ec6\u8282\u4f1a\u9010\u6e10\u892a\u53bb\u5176\u5e9f\u589f\u8d28\u611f\uff0c\u5e76\u5728\u4e0d\u77e5\u4e0d\u89c9\u4e2d\u8de8\u8d8a\u5c42\u9645\u8fb9\u754c\u5207\u5165\u672c\u5c42\u7ea7\u3002\n\n* \u5728[https://backrooms-wiki-cn.wikidot.com/level-c-67 Level C-67]\u5f53\u6d41\u6d6a\u8005\u5728\u8be5\u5c42\u7ea7\u5185\u53d1\u73b0\u4e00\u4e2a\u901a\u5f80\u5730\u9762\u7684\u697c\u68af\uff0c\u4e14\u697c\u68af\u5c3d\u5934\u662f\u4e00\u6247\u5e26\u6709\u628a\u624b\u4f46\u672a\u4e0a\u9501\u7684\u9632\u706b\u95e8\u65f6\u3002\u63a8\u95e8\u800c\u51fa\u5c06\u76f4\u63a5\u5230\u8fbe\u672c\u5c42\u7ea7\u67d0\u6761\u8857\u9053\u7684\u5783\u573e\u6876\u65c1\u6216\u884c\u9053\u6811\u4e0b\u3002\n\n* \u5728\u73b0\u5b9e\u4e16\u754c\u4e2d\u7684\u67d0\u4e9b\u8001\u65e7\u5c45\u6c11\u793e\u533a\u4e2d\uff0c\u4e8e\u6df1\u591c\u65f6\u5206\u5c1d\u8bd5\u6253\u5f00\u4e00\u4e2a\u4ece\u672a\u6709\u4eba\u5c45\u4f4f\u8fc7\u7684\u3001\u623f\u5c4b\u524d\u95e8\u8d34\u7740\u4e0d\u660e\u5c01\u6761\u7684\u5e9f\u5f03\u5c4b\u820d\uff0c\u82e5\u5728\u8fdb\u5165\u7684\u4e00\u77ac\u95f4\u611f\u53d7\u5230\u6e29\u5ea6\u7684\u9aa4\u964d\u548c\u706f\u5149\u7684\u95ed\u5408\uff0c\u5219\u53ef\u80fd\u76f4\u63a5\u5207\u51fa\u5e76\u843d\u81f3\u8be5\u5c42\u7ea7\u3002\n++++ \u51fa\u53e3\n* \u8be5\u5c42\u7ea7\u4e2d\u5b58\u5728\u4e00\u79cd\u6781\u5176\u7f55\u89c1\u4e14\u5b9d\u8d35\u7684\u73b0\u8c61\u2014\u2014\u201c\u5f02\u5e38\u9ece\u660e\u201d\u3002\u6d41\u6d6a\u8005\u5728\u6781\u5076\u7136\u7684\u65f6\u673a\u4e0b\uff0c\u53ef\u80fd\u4f1a\u5728\u67d0\u6761\u6ca1\u6709\u6b7b\u80e1\u540c\u7684\u6f2b\u957f\u8857\u9053\u5c3d\u5934\uff0c\u89c2\u5bdf\u5230\u5730\u5e73\u7ebf\u5904\u6cdb\u8d77\u4e00\u5c42\u6781\u6de1\u7684\u7070\u8272\u4eae\u5149\u3002\u82e5\u5f84\u76f4\u671d\u90a3\u5c42\u5fae\u5149\u5f92\u6b65\u524d\u8fdb\uff0c\u7ecf\u5386\u4e00\u6bb5\u4eff\u4f5b\u88ab\u62c9\u4f38\u81f3\u67